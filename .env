# ============================================================
#  代理节点批量体检工具 —— 配置文件
#  所有项都可以留空 / 删除, 会回退到默认值.
#  命令行参数优先级高于本文件.
# ============================================================

# ---------- 内核路径 ----------
# v2rayN 的 bin 目录 (会自动在其中寻找 sing_box/ 与 xray/ 子目录)
V2RAYN_BIN=C:\software\v2rayN-windows-64\bin
# 也可以直接指定可执行文件 (留空则用上面的目录自动探测)
# SING_BOX_PATH=C:\software\v2rayN-windows-64\bin\sing_box\sing-box.exe
# XRAY_PATH=C:\software\v2rayN-windows-64\bin\xray\xray.exe

# 内核选择策略: auto | sing-box | xray
#   auto 会根据协议自动选择 (hysteria2/tuic 只能用 sing-box)
KERNEL=auto

# ---------- 输入输出 ----------
# 输入: 一行一个代理 URI
NODES_FILE=proxiers.txt
# 输出: 全量检测明细 (JSON)
RESULTS_FILE=results.json
# 输出: 可用节点代理池 (一行一个原始 URI, 可直接被其他工具使用)
POOL_FILE=proxiers_google.txt
# 代理池是否只写入"综合可用"的节点 (true/false)
ONLY_USABLE=false

# ---------- 并发与超时 ----------
# 同时测试的节点数 (每个节点会启动一个独立内核实例)
CONCURRENCY=10
# 单次 HTTP 请求超时 (秒)
REQUEST_TIMEOUT=15
# 等待内核实例开始监听本地端口的超时 (秒)
START_TIMEOUT=12

# ---------- 检测项 ----------
# [已失效] 本版本 Antigravity 不再独立探测, 直接跟随 Google + Gemini 的结论.
# 保留该项仅为兼容旧配置, 改成 true/false 都不再影响行为.
CHECK_ANTIGRAVITY=true

# 链路 RTT 的采样次数 (对 cloudflare trace 连测 N 次取最小值).
# 越大越稳定但越慢; 3 次是速度与稳定性的折中.
RTT_ROUNDS=3
